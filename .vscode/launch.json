{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug MLP workspace",
      "type": "debugpy",
      "request": "launch",
      "module": "networks.mlp",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONUTF8": "1" },
      "console": "internalConsole"
    },
    {
      "name": "Debug current Python file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONPATH": "${workspaceFolder}"
      },
      "console": "integratedTerminal",
      "preLaunchTask": "Sync Python environment"
    }
  ]
}
