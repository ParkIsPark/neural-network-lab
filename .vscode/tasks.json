{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Sync Python environment",
      "type": "process",
      "command": "uv",
      "args": [
        "sync",
        "--locked"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Run MLP workspace",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "networks.mlp"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Sync Python environment",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
